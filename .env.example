# ============================================================
# Contact Form Inquiries — Zoho Mail (Two-Way Communication)
# ============================================================
# When a client fills out the website contact form:
# 1. Email is sent via Zoho Mail to the agency owner/team inbox.
# 2. Reply-To is automatically set to the client's email address.
# 3. The owner can directly click "Reply" in Zoho Mail to start talking with the client.
#
# Generate an App Password in Zoho:
# Zoho Account (accounts.zoho.com) > Security > App Passwords
ZOHO_USER=connect@rapidgrodigital.com
ZOHO_APP_PASSWORD=xxxx xxxx xxxx xxxx
ZOHO_HOST=smtp.zoho.in
ZOHO_PORT=465

# Where website enquiries should arrive (defaults to ZOHO_USER if omitted)
CONTACT_TO_EMAIL=connect@rapidgrodigital.com

# ============================================================
# Future Transactional Notifications — Resend (One-Way)
# ============================================================
# Reserved for one-way (ek-tarfa) automated system emails:
# e.g., Welcome emails, OTP verification, Invoice / Proposal PDFs.
RESEND_API_KEY=
RESEND_FROM_EMAIL=RapidGroDigital <notifications@your-verified-domain.com>

# ============================================================
# Groq AI Chatbot
# ============================================================
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-20b

# ============================================================
# Sanity CMS
# ============================================================
# Public identifiers are safe in the browser. The read token must be Viewer-only
# and is used server-side for drafts/visual preview. Never expose a write token
# to the deployed website.
NEXT_PUBLIC_SANITY_PROJECT_ID=projectid
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-17
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SANITY_API_READ_TOKEN=

# Local migration only: create an Editor token, run `npm run sanity:seed`, then
# remove this value. Do not configure it in the production deployment.
SANITY_API_WRITE_TOKEN=
